@page "{id:int}"
@model GamingCatalogue.Pages.GameDetailsModel
@{
    ViewData["Title"] = Model.Game.Title;
}
<style>

    .form-check-input:checked {
        background-color: #198754; 
        border-color: #198754;
    }

    .form-check-input:focus {
        border-color: #a3cfbb;
        box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.25);
    }
</style>
<div class="container mt-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Каталог</a></li>
            <li class="breadcrumb-item active">@Model.Game.Title</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <img src="@Model.Game.ImageUrl" class="card-img-top rounded" alt="@Model.Game.Title">
                <div class="card-body bg-light text-center">
                    <span class="badge bg-dark fs-6">Год выпуска: @Model.Game.Year</span>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <h1 class="display-5 fw-bold">@Model.Game.Title</h1>
            <hr />

            <h5>Описание</h5>
            <p class="text-muted" style="line-height: 1.6;">@Model.Game.Description</p>

            <div class="mt-3 mb-4">
                <h6>Текущие теги:</h6>
                @if (Model.Game.Tags.Any())
                {
                    foreach (var tag in Model.Game.Tags)
                    {
                        <span class="badge rounded-pill bg-success me-1">@tag.Name</span>
                    }
                }
                else
                {
                    <span class="text-muted small italic">Теги не назначены</span>
                }
            </div>


            <div class="card border-success shadow-sm mt-5">
                <div class="card-header bg-success text-white">
                    <i class="bi bi-tags-fill"></i>Редактирование тегов
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="UpdateTags" asp-route-id="@Model.Game.Id">
                        <div class="row g-3">
                            @foreach (var tag in Model.AllTags)
                            {
                                <div class="col-6 col-sm-4 col-lg-3">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox"
                                               name="selectedTags"
                                               value="@tag.Id"
                                               id="tag_@tag.Id"
                                               @(Model.Game.Tags.Any(t => t.Id == tag.Id) ? "checked" : "")>
                                        <label class="form-check-label" for="tag_@tag.Id">@tag.Name</label>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="border-top mt-3 pt-3">
                            <button type="submit" class="btn btn-success">
                                Сохранить изменения
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>