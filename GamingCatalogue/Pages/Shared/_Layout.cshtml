
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GamingCatalogue</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GamingCatalogue.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container navbar-wide d-flex align-items-center">

                <a class="navbar-brand" asp-area="" asp-page="/Index">GamingCatalogue</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Profile">Профиль</a>
                        </li>
                    </ul>
                <div class="profile-actions">
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <a href="/Auth" class="login-top-btn">Войти</a>
                        }
                        else
                        {
                            <div class="profile-menu-wrapper">
                                <button type="button" class="profile-menu-toggle" id="profileMenuToggle">
                                    <div class="avatar-small">
                                        <span>@User.Identity.Name.Substring(0, 1).ToUpper()</span>
                                    </div>
                                    <span class="profile-menu-username">@User.Identity.Name</span>
                                    <span class="profile-menu-arrow">▼</span>
                                </button>

                                <div class="profile-menu" id="profileMenu">
                                    <a href="/Profile" class="profile-menu-item">Мой профиль</a>
                                    <a href="/Library" class="profile-menu-item">Моя библиотека</a>
                                    <a href="/Settings" class="profile-menu-item">Настройки</a>
                                    <form method="post" asp-page="/Logout">
                                        <button type="submit" class="profile-menu-item logout">Выйти</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <div class="white-panel">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GamingCatalogue - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>